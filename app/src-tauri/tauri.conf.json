{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Super Alex Kidd Maker",
  "version": "0.1.0",
  "identifier": "io.github.kmartin91.superalexkiddmaker",
  "build": {
    "frontendDist": "../../maker/public",
    "beforeDevCommand": "node prepare.mjs",
    "beforeBuildCommand": "node prepare.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Super Alex Kidd Maker",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 680,
        "dragDropEnabled": false,
        "backgroundColor": "#000000",
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "Level editor and remake of Alex Kidd in Miracle World (bring your own ROM)",
    "longDescription": "Unofficial, non-commercial fan project. Build Alex Kidd in Miracle World levels and play them. You need your own ROM of the game; none is included.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgzNjExMzc2MjEyNDYzMkQKUldRdFl5UWhkaE5oZ3ljSEdIZXVHVVF5VjUzaGtBUGtWS2xCTzZHODZwbFcvMGxUODRBZ0ovbzkK",
      "endpoints": [
        "https://github.com/kmartin91/super-alex-kidd-maker/releases/latest/download/latest.json"
      ]
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "superalexkiddmaker"
        ]
      }
    }
  }
}
