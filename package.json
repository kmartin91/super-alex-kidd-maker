{
  "name": "super-alex-kidd-maker",
  "private": true,
  "description": "Unofficial level editor for Alex Kidd in Miracle World: build levels in a desktop app, and play them at once on a faithful C rewrite of the game (bring your own ROM)",
  "scripts": {
    "maker": "node maker/start.mjs",
    "web": "make -C engine web web-tools",
    "game": "make -C engine build/alexkidd && ./engine/build/alexkidd original.sms",
    "app": "cd app && tauri build",
    "app:dev": "cd app && tauri dev",
    "app:mac": "cd app && tauri build --target universal-apple-darwin",
    "app:linux": "node app/build-linux.mjs",
    "release:mac": "node app/release.mjs mac",
    "release:win": "node app/release.mjs win",
    "release:linux": "node app/build-linux.mjs --release",
    "release:json": "node app/latest-json.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.5"
  }
}
