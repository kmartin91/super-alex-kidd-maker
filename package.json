{
  "name": "super-alex-kidd-maker",
  "private": true,
  "description": "Unofficial fan remake of Alex Kidd in Miracle World: C engine and Mario Maker-style level editor (bring your own ROM)",
  "scripts": {
    "maker": "node maker/start.mjs",
    "web": "make -C engine web web-tools",
    "game": "make -C engine build/alexkidd && ./engine/build/alexkidd original.sms",
    "app": "cd app && tauri build",
    "app:dev": "cd app && tauri dev",
    "app:mac": "cd app && tauri build --target universal-apple-darwin"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.5"
  }
}
